NEXT_PUBLIC_API_BASE_URL=/api
GATEWAY_API_PORT=8023
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/sxy_portal
SXY_JWT_SECRET=change-me-to-a-random-32-char-secret
SXY_JWT_EXPIRE_HOURS=12
SXY_COOKIE_SECURE=false
SXY_BOOTSTRAP_ADMIN_USERNAME=admin
SXY_BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

